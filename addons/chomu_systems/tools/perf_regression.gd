extends RefCounted
class_name ChomuPerfRegression

## Records a flythrough session and computes statistics.
## @param samples Frame times in milliseconds.
## @param tier Tier identifier (e.g., "low", "medium", "high").
## @return Dictionary with keys: tier, avg, p95, p99, count.
func record_flythrough(samples: PackedFloat32Array, tier: String) -> Dictionary:
	var count = samples.size()
	if count == 0:
		return {"tier": tier, "avg": 0.0, "p95": 0.0, "p99": 0.0, "count": 0}
	
	var sorted = samples.duplicate()
	sorted.sort()
	
	var sum: float = 0.0
	for v in sorted:
		sum += v
	var avg = sum / count
	
	var p95_idx = min(int(ceil(0.95 * count)) - 1, count - 1)
	var p99_idx = min(int(ceil(0.99 * count)) - 1, count - 1)
	
	return {
		"tier": tier,
		"avg": avg,
		"p95": sorted[p95_idx],
		"p99": sorted[p99_idx],
		"count": count
	}

## Saves baseline results to a JSON file.
## @param path File path (user:// or absolute).
## @param results Array of result dictionaries from record_flythrough.
func save_baseline(path: String, results: Array) -> void:
	var data = {"results": results}
	var json_str = JSON.stringify(data)
	var file = FileAccess.open(path, FileAccess.WRITE)
	if file:
		file.store_string(json_str)
		file.close()

## Loads baseline results from a JSON file.
## @param path File path.
## @return Array of result dictionaries, or empty array on failure.
func load_baseline(path: String) -> Array:
	if not FileAccess.file_exists(path):
		return []
	var file = FileAccess.open(path, FileAccess.READ)
	if not file:
		return []
	var json_str = file.get_as_text()
	file.close()
	var parsed = JSON.parse_string(json_str)
	if parsed is Dictionary and parsed.has("results"):
		return parsed["results"]
	return []

## Compares baseline vs current results and returns regressions exceeding threshold.
## @param baseline Array of baseline result dictionaries.
## @param current Array of current result dictionaries.
## @param threshold Regression threshold as fraction (default 0.03 = 3%).
## @return Array of regression dictionaries with keys: tier, metric, base, now, pct.
func compare(baseline: Array, current: Array, threshold: float = 0.03) -> Array:
	var regressions = []
	var base_map = {}
	for b in baseline:
		if b is Dictionary and b.has("tier"):
			base_map[b["tier"]] = b
	
	for c in current:
		if not (c is Dictionary and c.has("tier")):
			continue
		var tier = c["tier"]
		if not base_map.has(tier):
			continue
		var b = base_map[tier]
		for metric in ["avg", "p95", "p99"]:
			if b.has(metric) and c.has(metric):
				var base_val = b[metric]
				var now_val = c[metric]
				if base_val > 0.0:
					var pct = (now_val - base_val) / base_val
					if pct > threshold:
						regressions.append({
							"tier": tier,
							"metric": metric,
							"base": base_val,
							"now": now_val,
							"pct": pct
						})
	return regressions

## Writes a markdown issue report for regressions.
## @param path Output file path.
## @param regressions Array from compare().
## @return true if file written (regressions non-empty), false otherwise.
func write_issue(path: String, regressions: Array) -> bool:
	if regressions.is_empty():
		return false
	
	var lines = []
	lines.append("# Performance Regression Report")
	lines.append("")
	lines.append("| Tier | Metric | Baseline | Current | Change |")
	lines.append("|------|--------|----------|---------|--------|")
	
	for r in regressions:
		var pct_str = "%.2f%%" % (r["pct"] * 100)
		lines.append("| %s | %s | %.2f ms | %.2f ms | +%s |" % [
			r["tier"], r["metric"], r["base"], r["now"], pct_str
		])
	
	lines.append("")
	lines.append("*Generated by ChomuPerfRegression*")
	
	var content = "\n".join(lines)
	var file = FileAccess.open(path, FileAccess.WRITE)
	if file:
		file.store_string(content)
		file.close()
		return true
	return false

## Helper for generating camera path points from a Curve3D.
class FlyThrough:
	## Samples n evenly spaced points along the curve.
	## @param path Curve3D to sample.
	## @param n Number of points to generate.
	## @return PackedVector3Array of sampled points.
	static func camera_path_points(path: Curve3D, n: int) -> PackedVector3Array:
		var points = PackedVector3Array()
		if not path or n <= 0:
			return points
		
		var baked = path.get_baked_points()
		if baked.is_empty():
			return points
		
		if n == 1:
			points.append(baked[0])
			return points
		
		var total_len = 0.0
		var lengths = PackedFloat32Array()
		lengths.append(0.0)
		for i in range(1, baked.size()):
			total_len += baked[i].distance_to(baked[i - 1])
			lengths.append(total_len)
		
		if total_len == 0.0:
			for i in range(n):
				points.append(baked[0])
			return points
		
		for i in range(n):
			var t = float(i) / float(n - 1)
			var target_len = t * total_len
			
			var idx = lengths.bsearch(target_len)
			if idx < 0:
				idx = ~idx
			idx = clamp(idx, 1, baked.size() - 1)
			
			var len_a = lengths[idx - 1]
			var len_b = lengths[idx]
			var local_t = 0.0
			if len_b > len_a:
				local_t = (target_len - len_a) / (len_b - len_a)
			
			var pt = baked[idx - 1].lerp(baked[idx], local_t)
			points.append(pt)
		
		return points

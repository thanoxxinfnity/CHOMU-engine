; Engine configuration file.
; Chomu City - GTA-style open world demo. Godot 4.7.2 / CHoMU Engine compatible.

config_version=5

[application]

config/name="Chomu City"
config/description="Open-world city demo built for CHoMU Engine (Godot 4.7.2)."
config/version="0.1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.149, 0.161, 0.184, 1)
boot_splash/show_image=true
boot_splash/image="res://splash.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
boot_splash/minimum_display_time=1200

[autoload]

Game="*res://scripts/Game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.149, 0.161, 0.184, 1)

diff --git a/platform/android/java/editor/build.gradle b/platform/android/java/editor/build.gradle
index fcbb102..58e48c5 100644
--- a/platform/android/java/editor/build.gradle
+++ b/platform/android/java/editor/build.gradle
@@ -64,6 +64,8 @@ def generateVersionCode() {
 }
 
 def generateVersionName() {
+    // CHoMU Engine release name (engine core is Godot 4.7.2).
+    return "1.0"
     String libraryVersionName = getGodotLibraryVersionName()
     int buildNumber = getEditorBuildNumber()
     return buildNumber == 0 ? libraryVersionName : libraryVersionName + ".$buildNumber"
@@ -78,7 +80,7 @@ android {
 
     defaultConfig {
         // The 'applicationId' suffix allows to install Godot 3.x(v3) and 4.x(v4) on the same device
-        applicationId "org.godotengine.editor.v4"
+        applicationId "com.tejas.chomuengine"
         versionCode generateVersionCode()
         versionName generateVersionName()
         minSdkVersion versions.minSdk
@@ -86,7 +88,7 @@ android {
 
         missingDimensionStrategy 'products', 'editor'
         manifestPlaceholders += [
-            editorAppName: "Godot Engine 4",
+            editorAppName: "CHoMU Engine",
             editorBuildSuffix: ""
         ]
 
